# PocketBase connection (can be https://pb.any1.tech or internal http://127.0.0.1:8090)
GEMINI_PB_URL=https://pb.any1.tech
POCKETBASE_SERVER_TOKEN=
# Or use dedicated executor service account:
GEMINI_PB_EMAIL=
GEMINI_PB_PASSWORD=

# Optional bearer token for /internal/* and /codex/status endpoints
SERVER_AUTH_TOKEN=

# Use a separate service account and recovery directory for each executor.
PB_EXECUTOR_QUEUE=codex
# For PB_EXECUTOR_QUEUE=gemini, provision these server-side values:
GEMINI_API_KEYS=
GEMINI_KEY_GROUPS=

# Queue polling (seconds, 0 = authenticated API only)
MAX_CONCURRENT_JOBS=8
PB_POLL_INTERVAL_SECONDS=3
RECOVERY_DIR=/data/recovery

# For Compose, set an absolute path to the dedicated Codex home containing auth.json.
CODEX_AUTH_DIR=

# Codex App Server settings
CODEX_BIN=codex
CODEX_CWD=/workspace
CODEX_SANDBOX=read-only
CODEX_APPROVALS_REVIEWER=user
CODEX_DEFAULT_MODEL=
CODEX_TURN_TIMEOUT_SECONDS=1800

# Google Antigravity CLI on PB_EXECUTOR_QUEUE=agy
AGY_BIN=agy
AGY_CWD=/data/antigravity-cli/workspaces
# Optional dedicated key. Defaults to the first configured GEMINI_API_KEYS entry.
AGY_GEMINI_API_KEY=
AGY_DEFAULT_MODEL=gemini-4-hydrogen
AGY_TURN_TIMEOUT_SECONDS=1800
