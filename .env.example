# PocketBase connection (can be https://pb.any1.tech or internal http://127.0.0.1:8090)
GEMINI_PB_URL=https://pb.any1.tech
POCKETBASE_SERVER_TOKEN=
# Or use dedicated executor service account:
GEMINI_PB_EMAIL=
GEMINI_PB_PASSWORD=

# Gemini / Antigravity API keys (one per line if multiple, or set in shell/compose)
GEMINI_API_KEYS=
GEMINI_KEY_GROUPS=

# Optional bearer token for /internal/* and /codex/status endpoints
SERVER_AUTH_TOKEN=

# Concurrency & optional PocketBase queue polling (seconds, 0 = webhook push only)
MAX_CONCURRENT_JOBS=8
PB_POLL_INTERVAL_SECONDS=3
RECOVERY_DIR=/data/recovery

# Codex App Server settings (uses host ~/.codex/auth.json)
CODEX_BIN=codex
CODEX_CWD=/workspace
CODEX_SANDBOX=workspace-write
CODEX_APPROVALS_REVIEWER=auto_review
CODEX_DEFAULT_MODEL=
CODEX_TURN_TIMEOUT_SECONDS=1800
